# NOIR Private Fitness Club — Environment Variables

# Database (REQUIRED — Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/noir?sslmode=require

# Session (REQUIRED in production)
SESSION_SECRET=

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (leave empty for same-origin only)
ALLOWED_ORIGINS=

# Admin credentials for seed (used by `npm run seed`)
ADMIN_EMAIL=owner@noirclub.com
ADMIN_PASSWORD=noir2026

# SMTP — enables email alerts on new leads when configured
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
