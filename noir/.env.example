# NOIR Private Fitness Club — Environment Variables

# Server
PORT=3000
NODE_ENV=development

# Session (REQUIRED in production — app refuses to start without it)
SESSION_SECRET=

# CORS — comma-separated list of allowed origins (leave empty for same-origin only)
ALLOWED_ORIGINS=

# Admin credentials for seed (used by `npm run seed`)
ADMIN_EMAIL=owner@noirclub.com
ADMIN_PASSWORD=noir2026

# SMTP — enables email alerts on new leads when configured
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Session store: sqlite (default) or redis
# Set to redis + provide REDIS_URL for horizontal scaling
SESSION_STORE=sqlite
REDIS_URL=redis://127.0.0.1:6379

# Rate limiter store: memory (default) or redis
# Set to redis + provide REDIS_URL for horizontal scaling
RATE_LIMIT_STORE=memory
